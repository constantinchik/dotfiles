#!/usr/bin/env bash
# vault-classify — suggest which PARA bucket a new note belongs in.
#
#   vault-classify "Pinecil Soldering Iron" < draft.md
#   echo "$BODY" | vault-classify "Note Title"
#
# Prints the top 2 buckets with probabilities, and the destination folder for each.
#
# Benchmarked on 57 stratified notes from this vault (ground truth = where they actually
# live): 88% top-1, vs 42.5% for always guessing "hardware". At confidence >= 0.8 it is
# 92% accurate over 86% of notes.
#
# This is a SUGGESTION, not automation. ~1 note in 8 is misfiled; a human confirms.
#
# Two findings baked in, do not "improve" them away:
#  * The criteria below encode THIS vault's conventions (bench gear vs. dwelling items).
#    Generic definitions scored 65%. The wording is the whole ballgame.
#  * Do NOT feed the `status:` frontmatter field. It is "active" on 148 of 171 notes, so
#    it carries no signal, and weighting it collapsed everything into "project" (61%).
#    If you know a note is active work, say so in prose in the content instead.
set -uo pipefail

die() { echo "vault-classify: $*" >&2; exit 1; }
[ $# -ge 1 ] || die "usage: vault-classify \"<note title>\" [< content-on-stdin]"
[ -n "${TYPESAFE_API_KEY:-}" ] || die "TYPESAFE_API_KEY not set (see ~/.zshrc.secrets)"
command -v jq >/dev/null || die "jq not found"

TITLE="$1"
BODY=""
[ ! -t 0 ] && BODY=$(head -c 2000)

read -r -d '' CRITERIA <<'JSON'
{
 "project": {"definition":"Active work the user is personally executing or building, with next steps or an in-progress state. The note tracks WORK, not a thing.","examples":["a build log for a lamp being assembled","a hub tracking several ongoing home projects","an IP allocation table the user maintains"],"not":"A finished product spec with nothing left to do."},
 "area": {"definition":"An ongoing life responsibility with no completion date: finance, health, relationships, travel, household management.","examples":["tax rules the user must follow yearly","a recurring shopping list","vault upkeep conventions"]},
 "guide": {"definition":"Instructions for performing a task: how-to, tutorial, procedure, strategy. Answers HOW DO I.","examples":["a migration walkthrough","best practices for a method"],"not":"A comparison of options, which is research."},
 "hardware": {"definition":"Electronics-bench, computing and workshop gear: components, dev boards, power supplies, tools for making things, computer peripherals.","examples":["ESP32 dev board","soldering iron","digital caliper","LED power supply","MagSafe ring holder","3D printer","SSD or NAS drive"],"not":"Items that serve the home as a dwelling - those are home-furniture."},
 "home-furniture": {"definition":"Objects that serve the household as a living space: furniture, fixtures, appliances, lighting, domestic smart-home devices, mounting hardware for the home, and everyday domestic objects.","examples":["coat hooks","humidifier","pedestal fan","drywall anchors","IKEA smart bulbs and buttons","smart thermostat","power strip mount","water bottle","label maker"],"not":"Bench electronics or workshop tools - those are hardware."},
 "software": {"definition":"An application, tool, or software configuration, documented as a thing that exists.","examples":["an app's settings","an architecture description of a tool"],"not":"Step-by-step instructions for using it, which is a guide."},
 "idea": {"definition":"A proposed concept the user has NOT started building. Speculative.","examples":["a design sketch for something that might be built"],"not":"Anything already in progress, which is a project."},
 "learning": {"definition":"Material about learning itself, study methods, or note-taking systems.","examples":["PARA vs GTD comparison","note-taking best practices"]},
 "quote": "A quotation or collected saying.",
 "recipe": "A cooking recipe or food preparation instructions.",
 "research": {"definition":"Investigation COMPARING options or gathering findings to reach a decision.","examples":["comparing restaurants","evaluating which drive to buy"],"not":"Instructions for a task, which is a guide."},
 "storage": "A physical storage layout: what is kept in which drawer, container, or shelf.",
 "vehicle": "Vehicle specifications or maintenance records."
}
JSON

folder_for() {
  case "$1" in
    project) echo "1. Projects/" ;;
    area) echo "2. Areas/" ;;
    guide) echo "3. Resources/Guides/" ;;
    hardware) echo "3. Resources/Hardware/" ;;
    home-furniture) echo "3. Resources/Home & Furniture/" ;;
    software) echo "3. Resources/Software/" ;;
    idea) echo "3. Resources/Ideas/" ;;
    learning) echo "3. Resources/Learning/" ;;
    quote) echo "3. Resources/Quotes/" ;;
    recipe) echo "3. Resources/Cooking/" ;;
    research) echo "3. Resources/Research/" ;;
    storage) echo "3. Resources/Storage/" ;;
    vehicle) echo "3. Resources/Vehicles/" ;;
    *) echo "(unknown)" ;;
  esac
}

RESP=$(jq -n --arg t "$TITLE" --arg b "$BODY" --argjson cr "$CRITERIA" '{
  state: { note_title: $t, note_content: $b },
  model: "jev-latest",
  questions: { folder: {
    type: "choice",
    instructions: "A new note is being filed into a PARA knowledge vault. Based on `note_title` and `note_content`, which category does it belong to?",
    criteria: $cr } } }' \
  | curl -sS --max-time 20 -X POST https://api.typesafe.ai/v1/systemone \
      -H "Authorization: Bearer $TYPESAFE_API_KEY" \
      -H "Content-Type: application/json" -d @-) || die "API request failed"

jq -e '.answers.folder' >/dev/null 2>&1 <<<"$RESP" \
  || { echo "classify failed:" >&2; jq -r '.error? // .' <<<"$RESP" >&2; exit 3; }

CONF=$(jq -r '.answers.folder.confidence' <<<"$RESP")
echo "### \"$TITLE\"  (confidence $CONF)"
jq -r '.answers.folder.probabilities | to_entries | sort_by(-.value) | .[:2][] | "\(.key)\t\(.value)"' <<<"$RESP" \
| while IFS=$'\t' read -r b p; do
    printf '  %-16s p=%-6s -> %s\n' "$b" "$p" "$(folder_for "$b")"
  done
awk -v c="$CONF" 'BEGIN{ if (c+0 < 0.8) print "  ! low confidence — present both options to the user before filing" }'
