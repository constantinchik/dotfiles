# ignored files
.DS_Store

.zshrc.secrets

# Ignore claude as it installs to the same location as our bin scripts
bin-macos/.local/bin/claude

# CuaDriver.app-managed symlinks (CLI binary + skill dirs -> /Applications/CuaDriver.app);
# machine-local, not tracked. Listed in every stow path the app/installer can land in.
bin-macos/.local/bin/cua-driver
opencode/.config/opencode/skills/cua-driver
opencode-server/.config/opencode/skills/cua-driver

# uv-managed python shim from the (removed) hermes installer — use pyenv instead
bin-macos/.local/bin/python3.11

# ~/.claude is currently directory-stowed: allowlist portable source, not
# an ever-growing list of runtime/auth/account/cache filenames.
claude/.claude/*
!claude/.claude/agents/
!claude/.claude/commands/
!claude/.claude/settings.json
!claude/.claude/skills/
claude/.claude/skills/*
!claude/.claude/skills/compress-pdf/
!claude/.claude/skills/home-assistant/

# Opencode server runtime data
opencode-server/.config/opencode/opencode.jsonc

# Generated skill views: source packages/adapters are tracked under agents/.
opencode/.config/opencode/skills/obsidian
opencode/.config/opencode/skills/personal-obsidian-vault
opencode/.config/opencode/skills/knowledge-access
opencode/.config/opencode/skills/shared-skill-maintenance
opencode/.config/opencode/skills/wrapup
opencode/.config/opencode/skills/sync-vault
opencode-server/.config/opencode/skills/obsidian
opencode-server/.config/opencode/skills/personal-obsidian-vault
opencode-server/.config/opencode/skills/knowledge-access
opencode-server/.config/opencode/skills/shared-skill-maintenance
opencode-server/.config/opencode/skills/wrapup
opencode-server/.config/opencode/skills/sync-vault
scripts/agents/__pycache__/
