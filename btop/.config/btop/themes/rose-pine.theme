# Rosé Pine theme for btop — https://github.com/rose-pine

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#191724"

# Main text color
theme[main_fg]="#e0def4"

# Title color for boxes
theme[title]="#e0def4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#31748f"

# Background color of selected item in processes box
theme[selected_bg]="#26233a"

# Foreground color of selected item in processes box
theme[selected_fg]="#ebbcba"

# Color of inactive/disabled text
theme[inactive_fg]="#6e6a86"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f6c177"

# Background color of the percentage meters
theme[meter_bg]="#26233a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f6c177"

# Cpu box outline color
theme[cpu_box]="#c4a7e7"

# Memory/disks box outline color
theme[mem_box]="#9ccfd8"

# Net up/down box outline color
theme[net_box]="#eb6f92"

# Processes box outline color
theme[proc_box]="#31748f"

# Box divider line and small boxes line color
theme[div_line]="#6e6a86"

# Temperature graph color (Foam -> Gold -> Love)
theme[temp_start]="#9ccfd8"
theme[temp_mid]="#f6c177"
theme[temp_end]="#eb6f92"

# CPU graph colors (Foam -> Iris -> Love)
theme[cpu_start]="#9ccfd8"
theme[cpu_mid]="#c4a7e7"
theme[cpu_end]="#eb6f92"

# Mem/Disk free meter (Iris -> Muted -> Text)
theme[free_start]="#c4a7e7"
theme[free_mid]="#6e6a86"
theme[free_end]="#e0def4"

# Mem/Disk cached meter (Foam -> Pine -> Iris)
theme[cached_start]="#9ccfd8"
theme[cached_mid]="#31748f"
theme[cached_end]="#c4a7e7"

# Mem/Disk available meter (Gold -> Rose -> Love)
theme[available_start]="#f6c177"
theme[available_mid]="#ebbcba"
theme[available_end]="#eb6f92"

# Mem/Disk used meter (Foam -> Pine -> Love)
theme[used_start]="#9ccfd8"
theme[used_mid]="#31748f"
theme[used_end]="#eb6f92"

# Download graph colors (Gold -> Rose -> Love)
theme[download_start]="#f6c177"
theme[download_mid]="#ebbcba"
theme[download_end]="#eb6f92"

# Upload graph colors (Foam -> Pine -> Love)
theme[upload_start]="#9ccfd8"
theme[upload_mid]="#31748f"
theme[upload_end]="#eb6f92"

# Process box color gradient for threads, mem and cpu usage (Foam -> Iris -> Love)
theme[process_start]="#9ccfd8"
theme[process_mid]="#c4a7e7"
theme[process_end]="#eb6f92"
